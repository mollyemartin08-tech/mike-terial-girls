  const int in2 = 7;
  const int in3 = 6;
  const int in4 = 5;
  const int enB = 3;
  const int button = 12;
  const int trigPin = 11;
  const int echoPin = 10;

  float xPos;
  float yPos;
  float theta;
  float duration;
  float distance;
  bool turnsComplete = false;
  bool obstacleDetected = false;

  void getLocation(){
      Enes100.updateLocation();
      xPos = Enes100.getX();
      yPos = Enes100.getY();
      theta = Enes100.getTheta();
      Enes100.print("X = "); Enes100.println(xPos);
      Enes100.print("Y = "); Enes100.println(yPos);
      Enes100.print("Theta = "); Enes100.println(theta);
  }

  void setLeftMotorPWM(float PWM) {
    if (PWM > 255) {
      PWM = 255;
    }
    if (PWM < -255) {
      PWM = -255;
    }
    if (PWM >= 0) {
      digitalWrite(in1, HIGH);
      digitalWrite(in2, LOW);
      analogWrite(enA, PWM);        
    } 
    else {
      digitalWrite(in1, LOW);
      digitalWrite(in2, HIGH);
      analogWrite(enA, abs(PWM));   
    }
  }

  void setRightMotorPWM(float PWM) {
    if (PWM > 255) {
      PWM = 255;
    }
    if (PWM < -255) {
      PWM = -255;
    }
    if (PWM >= 0) {
      digitalWrite(in3, HIGH);    
      digitalWrite(in4, LOW);   
      analogWrite(enB, PWM);
    } else {
      digitalWrite(in3, LOW);
      digitalWrite(in4, HIGH);
      analogWrite(enB, abs(PWM));  
    }
  }

  void turnOffMotors(){
    analogWrite(enA, 0);
    analogWrite(enB, 0); 
    digitalWrite(in1, LOW);
    digitalWrite(in2, LOW);
    digitalWrite(in3, LOW);
    digitalWrite(in4, LOW);
  }

void turnTo(float targetHeading) {
    float tolerance = 0.1; 
    float Kp = 50;       
    float error = targetHeading - theta;
    if (abs(error) < tolerance) {
        turnOffMotors();
    } 
    else {
        float speed = Kp * error;
        if (speed > 255) speed = 255;
        if (speed < -255) speed = -255;
        setLeftMotorPWM(-speed);
        setRightMotorPWM(speed);
    }
}

